#!/usr/bin/env bash
# gh runners: look at self-hosted GitHub Actions runners and manage the ones on this Mac.
# list / runs / local / aliases only read. add / remove / start / stop / restart / upgrade change things.
set -euo pipefail

usage() {
  cat <<'HELP'
Usage: gh runners [list] [TARGET]          runners on GitHub: name / status / busy / labels
       gh runners runs [TARGET] [LIMIT]    recent workflow runs (default 10, max 100)
       gh runners aliases                  show the configured aliases

Runners on this Mac (macOS, Apple Silicon; each runner is a launchd service):
       gh runners add [TARGET] [--name NAME] [--dir DIR] [--labels LABELS]
                                           (re)register a runner (setup is an alias)
       gh runners local [RUNNER]           runners on this Mac: service state and GitHub status
       gh runners remove RUNNER [--keep-dir] [--yes]
                                           unregister, uninstall the service, delete the directory
       gh runners start|stop|restart [RUNNER]
       gh runners upgrade [RUNNER]         update to the latest actions/runner release

TARGET is OWNER/REPO, an alias from the config file, or "all" (every alias).
Without TARGET the current repository is used (GH_REPO or the git remote).
RUNNER is a runner name, its directory, or a TARGET; without it, every runner on this Mac.
Runners on this Mac are the directories ~/actions-runner-* that hold a registration (.runner).

Config: ${GH_RUNNERS_CONFIG:-${XDG_CONFIG_HOME:-~/.config}/gh-runners/repos}
  one "ALIAS OWNER/REPO" per line; "#" starts a comment.
Tables are aligned on a terminal and tab-separated when piped;
GH_RUNNERS_FORMAT=table|tsv overrides that.
--json (list, runs, local, aliases) prints one JSON array instead, for scripts.
HELP
}

die() { printf '%s\n' "$*" >&2; exit 1; }

config=${GH_RUNNERS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/gh-runners/repos}
repo_re='^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'
export GH_PAGER=cat GH_PROMPT_DISABLED=1 NO_COLOR=1

# Aligned columns for a terminal, tab-separated for a pipe; GH_RUNNERS_FORMAT wins.
format=${GH_RUNNERS_FORMAT:-}
if [ -z "$format" ]; then
  if [ -t 1 ]; then format=table; else format=tsv; fi
fi
case "$format" in table | tsv) ;; *) die "GH_RUNNERS_FORMAT must be table or tsv: $format" ;; esac

# Read tab-separated rows and pad every column but the last to the widest cell.
table() {
  [ "$format" = table ] || { cat; return; }
  awk -F'\t' '
    { for (i = 1; i <= NF; i++) { cell[NR, i] = $i; if (length($i) > width[i]) width[i] = length($i) }
      if (NF > cols) cols = NF; rows = NR }
    END { for (r = 1; r <= rows; r++) { line = ""
            for (i = 1; i <= cols; i++) {
              if (i > 1) line = line "  "
              if (i < cols) line = line sprintf("%-" width[i] "s", cell[r, i]); else line = line cell[r, i] }
            sub(/[[:space:]]+$/, "", line); print line } }'
}

# Print "ALIAS<TAB>OWNER/REPO" for each valid config line.
aliases() {
  [ -f "$config" ] || return 0
  local line name repo extra
  while IFS= read -r line || [ -n "$line" ]; do
    read -r name repo extra <<<"${line%%#*}"
    [ -n "$name" ] || continue
    [ -z "$extra" ] || die "Invalid line in $config: $name $repo $extra"
    [[ "$repo" =~ $repo_re ]] || die "Invalid repository for alias $name in $config: $repo"
    printf '%s\t%s\n' "$name" "$repo"
  done <"$config"
}

# Resolve TARGET into the global array "repos" before any request is made.
resolve() {
  local target=${1:-} line table=''
  repos=()
  # Read the config only when the target needs it, so a broken file never blocks OWNER/REPO.
  if [ "$target" = all ] || { [ -n "$target" ] && [[ "$target" != */* ]]; }; then
    table=$(aliases) || exit 1
  fi
  if [ -z "$target" ]; then
    target=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) ||
      die 'Not in a GitHub repository; pass OWNER/REPO, an alias or "all"'
    repos=("$target")
  elif [ "$target" = all ]; then
    [ -n "$table" ] || die "No aliases in $config"
    while IFS=$'\t' read -r _ line; do repos+=("$line"); done <<<"$table"
  elif [[ "$target" == */* ]]; then
    repos=("$target")
  else
    while IFS=$'\t' read -r _ line; do repos+=("$line"); done < <(awk -F'\t' -v a="$target" '$1 == a' <<<"$table")
    [ "${#repos[@]}" -gt 0 ] || die "Unknown command or alias: $target (see gh runners --help and gh runners aliases)"
  fi
  for line in "${repos[@]}"; do
    [[ "$line" =~ $repo_re ]] || die "Invalid repository: $line (expected OWNER/REPO)"
  done
}

# Print the stdin lines (one JSON value each) as one JSON array.
json_array() {
  awk 'BEGIN { printf "[" } NF { printf "%s%s", (n++ ? "," : ""), $0 } END { print "]" }'
}

# Print $1 as a JSON string.
json_str() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  printf '"%s"' "$s"
}

# One JSON object per line for REPO; the repository name is safe in a jq string (repo_re).
view_json() {
  local mode=$1 repo=$2 limit=${3:-}
  if [ "$mode" = list ]; then
    gh api --method GET --paginate "repos/$repo/actions/runners?per_page=100" --jq "
      .runners[] | {repository: \"$repo\", name, status, busy, labels: [.labels[].name]} | tojson"
  else
    gh run list --repo "$repo" --limit "$limit" \
      --json databaseId,status,conclusion,workflowName,displayTitle,headBranch,createdAt,url --jq "
      .[] | {repository: \"$repo\", id: .databaseId, status,
        conclusion: (if (.conclusion // \"\") == \"\" then null else .conclusion end),
        workflow: .workflowName, title: .displayTitle, branch: .headBranch, createdAt, url} | tojson"
  fi
}

view() {
  local mode=$1 repo=$2 limit=${3:-} data
  printf '\n== %s ==\n' "$repo"
  # Capture first so an empty result is distinct from an API failure, and so the table can be aligned.
  if [ "$mode" = list ]; then
    data=$(gh api --method GET --paginate "repos/$repo/actions/runners?per_page=100" \
      --jq '.runners[] | [.name, (if .busy then "\(.status),busy" else .status end),
        ([.labels[].name] | join(","))] | @tsv') || return
    { printf 'NAME\tSTATUS\tLABELS\n'; printf '%s\n' "${data:-(no runners visible)}"; } | table
  else
    data=$(gh run list --repo "$repo" --limit "$limit" \
      --json databaseId,status,conclusion,workflowName,displayTitle,headBranch,createdAt,url --jq '
      if length == 0 then "(no workflow runs)" else
      .[] | [.databaseId, (if (.conclusion // "") == "" then .status else .conclusion end), .workflowName,
        (.displayTitle | if length > 40 then .[0:39] + "\u2026" else . end), .headBranch,
        (.createdAt | sub("T"; " ") | sub(":[0-9][0-9]Z$"; " UTC")), .url] | @tsv end') || return
    { printf 'ID\tRESULT\tWORKFLOW\tTITLE\tBRANCH\tCREATED\tURL\n'; printf '%s\n' "$data"; } | table
  fi
}

show() {
  local mode=$1 limit=${3:-} repo result=0 data lines=''
  resolve "${2:-}"
  for repo in "${repos[@]}"; do
    # Keep showing the other repositories when one is inaccessible; still fail overall.
    if [ "$json" = 1 ] && data=$(view_json "$mode" "$repo" "$limit"); then
      [ -z "$data" ] || lines+=$data$'\n'
    elif [ "$json" = 0 ] && view "$mode" "$repo" "$limit"; then
      :
    else
      printf 'Cannot read %s. Check gh auth status and repository permissions (runner listing requires admin access / runner read permission).\n' "$repo" >&2
      result=1
    fi
  done
  if [ "$json" = 1 ]; then printf '%s' "$lines" | json_array; fi
  return "$result"
}

require_mac() {
  [ "$(uname -s)" = Darwin ] || die "$1 runs on macOS only"
  [ "$(uname -m)" = arm64 ] || die "$1 supports Apple Silicon (arm64) only"
}

# Read one string field from a runner's .runner file (JSON written by config.sh).
runner_field() {
  sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$1/.runner" | head -n 1
}

runner_repo() {
  local url
  url=$(runner_field "$1" gitHubUrl)
  url=${url%/}
  printf '%s\n' "${url#https://github.com/}"
}

runner_version() {
  if [ -x "$1/bin/Runner.Listener" ]; then
    "$1/bin/Runner.Listener" --version 2>/dev/null && return
  fi
  cat "$1/.runner-version" 2>/dev/null || echo '?'
}

# launchd state of a runner: running / stopped / not installed.
service_state() {
  local plist label
  [ -f "$1/.service" ] || { echo 'not installed'; return; }
  plist=$(cat "$1/.service")
  label=$(basename "$plist" .plist)
  if launchctl list "$label" 2>/dev/null | grep -q '"PID"'; then echo running; else echo stopped; fi
}

# Set the global array "dirs" to the runners on this Mac that match SELECTOR (all when empty).
select_local() {
  local sel=${1:-} dir name repo table='' target=''
  dirs=()
  if [ -n "$sel" ] && [ "$sel" != all ] && [[ "$sel" != */* ]] && [ ! -d "$sel" ]; then
    table=$(aliases) || exit 1
    target=$(awk -F'\t' -v a="$sel" '$1 == a { print $2 }' <<<"$table")
  fi
  for dir in "$HOME"/actions-runner-*; do
    [ -f "$dir/.runner" ] || continue
    name=$(runner_field "$dir" agentName)
    repo=$(runner_repo "$dir")
    if [ -z "$sel" ] || [ "$sel" = all ] || [ "$sel" = "$name" ] || [ "$sel" = "$repo" ] ||
      { [ -n "$target" ] && [ "$target" = "$repo" ]; } ||
      { [ -d "$sel" ] && [ "$(cd "$sel" && pwd -P)" = "$(cd "$dir" && pwd -P)" ]; }; then
      dirs+=("$dir")
    fi
  done
  if [ "${#dirs[@]}" -eq 0 ]; then
    if [ -n "$sel" ]; then die "No runner on this Mac matches: $sel (see gh runners local)"; fi
    die 'No runners on this Mac (add one with gh runners add)'
  fi
}

latest_version() {
  gh api repos/actions/runner/releases/latest --jq '.tag_name | ltrimstr("v")'
}

# Download actions/runner VERSION into DIR (the current directory).
install_runner() {
  local version=$1 tarball
  printf 'Downloading actions/runner %s\n' "$version"
  tarball="actions-runner-osx-arm64-$version.tar.gz"
  curl -fsSL -o "$tarball" "https://github.com/actions/runner/releases/download/v$version/$tarball"
  tar xzf "$tarball"
  rm -f "$tarball"
  printf '%s\n' "$version" >.runner-version
}

# Remove the launchd service of the runner in the current directory. svc.sh uninstall stops with
# the plist left behind when unload fails (e.g. already unloaded), so remove the recorded plist directly.
uninstall_service() {
  [ -f .service ] || return 0
  local plist
  plist=$(cat .service)
  printf 'Removing service: %s\n' "$plist"
  launchctl unload "$plist" 2>/dev/null || true
  rm -f "$plist" .service
}

# Unregister the runner in the current directory from REPO. With "strict" a failure is returned;
# otherwise it falls back to dropping the local registration files (add re-registers with --replace).
unregister() {
  local token
  token=$(gh api -X POST "repos/$1/actions/runners/remove-token" --jq .token) || return
  if ./config.sh remove --token "$token"; then return 0; fi
  [ "${2:-}" != strict ] || return 1
  rm -f .runner .credentials .credentials_rsaparams
}

add() {
  local target='' name='' dir='' labels='' host repo old version token
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --repo) target=${2:?--repo needs a value}; shift 2 ;;
      --name) name=${2:?--name needs a value}; shift 2 ;;
      --dir) dir=${2:?--dir needs a value}; shift 2 ;;
      --labels) labels=${2:?--labels needs a value}; shift 2 ;;
      -*) usage >&2; return 1 ;;
      *) [ -z "$target" ] || die 'add takes one repository'; target=$1; shift ;;
    esac
  done
  require_mac add
  resolve "$target"
  [ "${#repos[@]}" -eq 1 ] || die 'add takes exactly one repository'
  repo=${repos[0]}
  gh auth status >/dev/null 2>&1 || die 'Run gh auth login first'
  host=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
  name=${name:-${repo%%/*}-${repo#*/}}
  dir=${dir:-$HOME/actions-runner-${repo#*/}}
  labels=${labels:-$host}

  mkdir -p "$dir"
  cd "$dir"
  uninstall_service
  # Remove the existing registration (one from another machine or old host name is replaced by --replace).
  if [ -f .runner ]; then
    printf 'Removing existing runner: %s\n' "$dir"
    old=$(runner_repo .)
    unregister "${old:-$repo}"
  fi

  # Keep the runner itself on the latest release.
  version=$(latest_version)
  if [ ! -x ./config.sh ] || [ "$(cat .runner-version 2>/dev/null)" != "$version" ]; then
    install_runner "$version"
  fi

  # The registration token is fetched each time and never stored.
  token=$(gh api -X POST "repos/$repo/actions/runners/registration-token" --jq .token)
  ./config.sh --unattended --replace \
    --url "https://github.com/$repo" \
    --token "$token" \
    --name "$name" \
    --labels "$labels" \
    --work _work

  ./svc.sh install
  ./svc.sh start
  ./svc.sh status || true

  printf '\nRegistered %s on %s. Check that it is online: gh runners list %s\n' "$name" "$repo" "$repo"
}

show_local() {
  local dir name repo state status busy version data result=0 rows='' objects=''
  require_mac local
  select_local "${1:-}"
  # Collect the rows first: a pipeline would run the loop in a subshell and lose "result".
  for dir in "${dirs[@]}"; do
    name=$(runner_field "$dir" agentName)
    repo=$(runner_repo "$dir")
    state=$(service_state "$dir")
    version=$(runner_version "$dir")
    if data=$(gh api --method GET --paginate "repos/$repo/actions/runners?per_page=100" \
      --jq ".runners[] | select(.name == \"$name\") | \"\\(.status) \\(.busy)\""); then
      status=${data% *} busy=${data#* }
      [ -n "$data" ] || status='not registered' busy=false
    else
      status='?' busy='?'
      result=1
    fi
    if [ "$json" = 1 ]; then
      objects+=$(printf '{"name":%s,"repository":%s,"service":%s,"status":%s,"busy":%s,"version":%s,"dir":%s}' \
        "$(json_str "$name")" "$(json_str "$repo")" "$(json_str "$state")" \
        "$(if [ "$status" = '?' ]; then echo null; else json_str "$status"; fi)" \
        "$(if [ "$busy" = '?' ]; then echo null; else echo "$busy"; fi)" \
        "$(if [ "$version" = '?' ]; then echo null; else json_str "$version"; fi)" \
        "$(json_str "$dir")")$'\n'
    else
      if [ "$busy" = true ]; then status+=,busy; fi
      rows+=$(printf '%s\t%s\t%s\t%s\t%s\t%s' "$name" "$repo" "$state" "$status" "$version" "$dir")$'\n'
    fi
  done
  if [ "$json" = 1 ]; then
    printf '%s' "$objects" | json_array
  else
    { printf 'NAME\tREPOSITORY\tSERVICE\tGITHUB\tVERSION\tDIR\n'; printf '%s' "$rows"; } | table
  fi
  [ "$result" = 0 ] || printf 'Some GitHub states could not be read (?). Check gh auth status and admin access.\n' >&2
  return "$result"
}

remove() {
  local sel='' keep=0 yes=0 dir name repo answer
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --keep-dir) keep=1 ;;
      -y | --yes) yes=1 ;;
      -*) usage >&2; return 1 ;;
      *) [ -z "$sel" ] || die 'remove takes one runner'; sel=$1 ;;
    esac
    shift
  done
  if [ -z "$sel" ] || [ "$sel" = all ]; then
    die 'remove needs a RUNNER (name, directory or repository)'
  fi
  require_mac remove
  select_local "$sel"
  for dir in "${dirs[@]}"; do
    printf 'Will remove %s (%s) in %s\n' "$(runner_field "$dir" agentName)" "$(runner_repo "$dir")" "$dir"
  done
  if [ "$yes" = 0 ]; then
    [ -t 0 ] || die 'Not a terminal; pass --yes to remove'
    read -r -p 'Remove? [y/N] ' answer
    [[ "$answer" =~ ^[Yy] ]] || die 'Cancelled'
  fi
  gh auth status >/dev/null 2>&1 || die 'Run gh auth login first'
  for dir in "${dirs[@]}"; do
    name=$(runner_field "$dir" agentName)
    repo=$(runner_repo "$dir")
    if ! (cd "$dir" && uninstall_service && unregister "$repo" strict); then
      die "Could not unregister $name from $repo; kept $dir (run gh runners remove again)"
    fi
    if [ "$keep" = 0 ]; then rm -rf "$dir"; fi
    printf 'Removed %s from %s\n' "$name" "$repo"
  done
}

# start / stop / restart through the runner's own svc.sh.
service() {
  local action=$1 dir
  [ "$#" -le 2 ] || die "$action takes at most one runner"
  require_mac "$action"
  select_local "${2:-}"
  for dir in "${dirs[@]}"; do
    [ -f "$dir/.service" ] || die "No service installed in $dir (run gh runners add again)"
    printf '%s %s\n' "$action" "$(runner_field "$dir" agentName)"
    case "$action" in
      restart) (cd "$dir" && ./svc.sh stop && ./svc.sh start) ;;
      *) (cd "$dir" && "./svc.sh" "$action") ;;
    esac
  done
}

upgrade() {
  local dir version current state
  [ "$#" -le 1 ] || die 'upgrade takes at most one runner'
  require_mac upgrade
  select_local "${1:-}"
  version=$(latest_version)
  for dir in "${dirs[@]}"; do
    current=$(runner_version "$dir")
    if [ "$current" = "$version" ]; then
      printf '%s is already %s\n' "$(runner_field "$dir" agentName)" "$version"
      continue
    fi
    state=$(service_state "$dir")
    (
      cd "$dir"
      if [ "$state" = running ]; then ./svc.sh stop; fi
      install_runner "$version"
      if [ "$state" = running ]; then ./svc.sh start; fi
    )
    printf 'Upgraded %s: %s -> %s\n' "$(runner_field "$dir" agentName)" "$current" "$version"
  done
}

command -v gh >/dev/null 2>&1 || die 'gh is required'
cmd=${1:-list}
case "$cmd" in
  list | runs | aliases | add | setup | local | remove | start | stop | restart | upgrade) [ "$#" -gt 0 ] && shift ;;
  -h | --help | help) usage; exit 0 ;;
  *) cmd=list ;; # "gh runners OWNER/REPO" is short for list
esac
# --json may come anywhere after the command.
json=0 args=()
for arg in "$@"; do
  if [ "$arg" = --json ]; then json=1; else args+=("$arg"); fi
done
set -- ${args[@]+"${args[@]}"}
case "$cmd" in
  list | runs | local | aliases) ;;
  *) [ "$json" = 0 ] || die '--json works with list, runs, local and aliases' ;;
esac
case "${1:-}" in -h | --help) usage; exit 0 ;; esac
case "$cmd" in
  list)
    [ "$#" -le 1 ] || die 'list accepts only a repository target'
    show list "${1:-}"
    ;;
  runs)
    [ "$#" -le 2 ] || die 'runs accepts a repository target and a limit'
    limit=${2:-10}
    if ! [[ "$limit" =~ ^[1-9][0-9]{0,2}$ ]] || [ "$limit" -gt 100 ]; then
      die 'LIMIT must be 1..100'
    fi
    show runs "${1:-}" "$limit"
    ;;
  aliases)
    [ "$#" -eq 0 ] || die 'aliases takes no arguments'
    if [ "$json" = 1 ]; then
      table=$(aliases) || exit 1
      while IFS=$'\t' read -r name repo; do
        [ -z "$name" ] || printf '{"alias":%s,"repository":%s}\n' "$(json_str "$name")" "$(json_str "$repo")"
      done <<<"$table" | json_array
    else
      aliases | table
    fi
    ;;
  add | setup) add "$@" ;;
  local)
    [ "$#" -le 1 ] || die 'local accepts only a runner'
    show_local "${1:-}"
    ;;
  remove) remove "$@" ;;
  start | stop | restart) service "$cmd" "$@" ;;
  upgrade) upgrade "$@" ;;
esac
